-    /// Chat bubble: strips the timers in the background, once per message while a write is already
-    /// running for it. The bubble re-renders by itself when the message changes.
-    public static func stripTimersInBackground(postbox: Postbox, accountPeerId: PeerId, message: Message) {
-        guard self.applies(message: message, accountPeerId: accountPeerId) else {
-            return
-        }
-        let id = message.id
-        if !self.inFlight.begin(id) {
-            return
-        }
-        let key = accountPeerId.toInt64()
-        let viewOnceEnabled = PampGramTemporaryMediaDisplay.shared.isViewOnceEnabled(accountKey: key)
