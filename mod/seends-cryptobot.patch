-    static func stripIfNeeded(transaction: Transaction, messageIds: [MessageId]) {
-        if messageIds.isEmpty {
-            return
-        }
-        let settings = PampGramCore.settings(transaction: transaction)
-        if !settings.bypassViewOnceMediaEnabled && !settings.bypassTimedMediaEnabled {
-            return
-        }
-        for id in messageIds {
-            self.strip(transaction: transaction, id: id, viewOnceEnabled: settings.bypassViewOnceMediaEnabled, timedEnabled: settings.bypassTimedMediaEnabled)
-        }
-    }
-}
