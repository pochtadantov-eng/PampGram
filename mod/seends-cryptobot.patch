-        private var ids = Set<MessageId>()
-
-        func begin(_ id: MessageId) -> Bool {
-            self.lock.lock()
-            defer { self.lock.unlock() }
-            return self.ids.insert(id).inserted
-        }
-
-        func end(_ id: MessageId) {
-            self.lock.lock()
-            self.ids.remove(id)
-            self.lock.unlock()
-        }
-    }
-
-    private static let inFlight = InFlight()
-
-    /// Same range `Message.containsSecretMedia` and `tagsForStoreMessage` call "secret".
-    private static func isSecretRangeTimeout(_ timeout: Int32) -> Bool {
-        return timeout <= 60 || timeout == viewOnceTimeout
-    }
-
-    /// Photos, videos and GIFs — what the bubble's media node draws. Round videos, voice messages
-    /// and music play through their own nodes and are left exactly as stock Telegram has them.
-    private static func isPlainMedia(_ message: Message) -> Bool {
-        for media in message.media {
-            if media is TelegramMediaImage {
-                return true
-            } else if let file = media as? TelegramMediaFile {
-                if file.isInstantVideo || file.isVoice || file.isMusic {
-                    return false
-                }
-                if file.isVideo || file.isAnimated {
-                    return true
-                }
-            }
-        }
-        return false
-    }
-
-    private static func isToggleOn(message: Message, viewOnceEnabled: Bool, timedEnabled: Bool) -> Bool {
-        return message.minAutoremoveOrClearTimeout == viewOnceTimeout ? viewOnceEnabled : timedEnabled
-    }
-
-    /// The timers can be removed from this message right now.
-    private static func isStrippable(message: Message, viewOnceEnabled: Bool, timedEnabled: Bool) -> Bool {
