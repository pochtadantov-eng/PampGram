-                return !self.isSecretRangeTimeout(attribute.timeout)
-            } else if let attribute = attribute as? AutoclearTimeoutMessageAttribute {
-                return !self.isSecretRangeTimeout(attribute.timeout)
-            }
-            return true
-        }
-    }
-
-    /// Chat bubble: draw the media as a normal one. Uses the in-memory mirror of the settings, so
