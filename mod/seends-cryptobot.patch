-        }
-        let key = accountPeerId.toInt64()
-        return self.isToggleOn(message: message, viewOnceEnabled: PampGramTemporaryMediaDisplay.shared.isViewOnceEnabled(accountKey: key), timedEnabled: PampGramTemporaryMediaDisplay.shared.isTimedEnabled(accountKey: key))
-    }
-
-    /// Opening: the message should go to the regular gallery instead of the secret viewer.
-    public static func applies(message: Message, accountPeerId: PeerId) -> Bool {
-        let key = accountPeerId.toInt64()
