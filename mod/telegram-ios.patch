diff --git a/submodules/TelegramCore/Sources/PampGram/PampGramDeletedMessageCapture.swift b/submodules/TelegramCore/Sources/PampGram/PampGramDeletedMessageCapture.swift
new file mode 100644
index 00000000..824b8e40
--- /dev/null
+++ b/submodules/TelegramCore/Sources/PampGram/PampGramDeletedMessageCapture.swift
@@ -0,0 +1,124 @@
+import Foundation
+import Postbox
+import PampGramCore
+
+/// Captures messages the other side deleted, before Postbox removes them, so they stay
+/// visible (dimmed, red trash badge — see the patch to `ChatMessageBubbleItemNode.swift`) in
+/// the chat instead of vanishing. Called from `replayFinalState` in
+/// `AccountStateManagementUtils.swift`, right before the real
+/// `deleteMessages`/`deleteMessagesWithGlobalIds` call that would otherwise be the only thing
+/// that ever touches these ids.
+///
+/// Lives in `TelegramCore` itself (rather than a separate mod module) on purpose: it needs
+/// `TelegramMediaAction`/`TextEntitiesMessageAttribute`/`Namespaces`, all TelegramCore types,
+/// and `PampGramCore` — which it does depend on — must never depend back on `TelegramCore`,
+/// so the reusable record/attribute/store types it calls into live there instead of here.
+enum PampGramDeletedMessageCapture {
+    /// `messageIds` must already be resolved to peer-scoped `MessageId`s — for the "global id"
+    /// deletion path (regular private chats and basic groups), resolve with
+    /// `transaction.messageIdsForGlobalIds(_:)` before calling this.
+    static func captureBeforeDelete(transaction: Transaction, accountPeerId: PeerId, messageIds: [MessageId]) {
+        let settings = PampGramCore.settings(transaction: transaction)
+        guard settings.antiDeleteMessagesEnabled else {
+            return
+        }
+        let excludedPeerIds = Set(settings.antiDeleteExcludedPeerIds)
+        let now = Int32(Date().timeIntervalSince1970)
+        for id in messageIds {
+            // Never resurrect PampGram's own local-only rows (phantom gifts, earlier
+            // resurrections) — they're not real deletions, and re-capturing an already-local
+            // message would just duplicate it forever.
+            if id.namespace == Namespaces.Message.Local {
+                continue
+            }
+            // A chat the user picked to exclude from anti-delete entirely — left to behave
+            // like stock Telegram, deletions and all.
+            if excludedPeerIds.contains(id.peerId) {
+                continue
+            }
+            guard let message = transaction.getMessage(id) else {
+                continue
+            }
+            // Only messages the *other* side sent — a message this account's own user deleted
+            // (on this device or another) is a real, intentional delete and is left alone.
+            guard let author = message.author, author.id != accountPeerId else {
+                continue
+            }
+            // Service messages (join/leave, calls, real gift actions, etc.) aren't content the
+            // user typed or sent — nothing meaningful to resurrect.
+            if message.media.contains(where: { $0 is TelegramMediaAction }) {
+                continue
+            }
+
+            var attributes: [MessageAttribute] = message.attributes.filter { $0 is TextEntitiesMessageAttribute }
+            attributes.append(PampGramDeletedByRemoteAttribute(deletedAt: now))
+
+            let globallyUniqueId = Int64.random(in: Int64.min ... Int64.max)
+            let storeMessage = StoreMessage(
+                id: .Partial(id.peerId, Namespaces.Message.Local),
+                customStableId: nil,
+                globallyUniqueId: globallyUniqueId,
+                groupingKey: message.groupingKey,
+                threadId: message.threadId,
+                timestamp: message.timestamp,
+                flags: StoreMessageFlags(message.flags),
+                tags: message.tags,
+                globalTags: message.globalTags,
+                localTags: message.localTags,
+                forwardInfo: message.forwardInfo.map(StoreMessageForwardInfo.init),
+                authorId: author.id,
+                text: message.text,
+                attributes: attributes,
+                media: message.media
+            )
+            let insertedIds = transaction.addMessages([storeMessage], location: .Random)
+            guard let localMessageId = insertedIds[globallyUniqueId] else {
+                continue
+            }
+
+            var textPreview = message.text
+            if textPreview.isEmpty, let firstMedia = message.media.first {
+                textPreview = self.mediaPreview(firstMedia)
+            }
+            if textPreview.count > 120 {
+                textPreview = String(textPreview.prefix(120))
+            }
+
+            PampGramDeletedMessageStore.add(transaction: transaction, message: PampGramDeletedMessage(
+                id: Int64.random(in: 1...Int64.max),
+                peerId: id.peerId,
+                authorId: author.id,
+                originalTimestamp: message.timestamp,
+                deletedAt: now,
+                textPreview: textPreview,
+                localMessageId: localMessageId
+            ))
+        }
+    }
+
+    private static func mediaPreview(_ media: Media) -> String {
+        switch media {
+        case is TelegramMediaImage:
+            return "Фото"
+        case let file as TelegramMediaFile:
+            if file.isVideo {
+                return "Видео"
+            } else if file.isVoice {
+                return "Голосовое сообщение"
+            } else if file.isSticker {
+                return "Стикер"
+            } else if file.isAnimated {
+                return "GIF"
+            }
+            return file.fileName ?? "Файл"
+        case is TelegramMediaContact:
+            return "Контакт"
+        case is TelegramMediaMap:
+            return "Геолокация"
+        case is TelegramMediaPoll:
+            return "Опрос"
+        default:
+            return "Сообщение"
+        }
+    }
+}
