+// PampGram: adds a "PampGram" → "Изменить визуально" entry to a single message's long-press
+// menu when the "Изменить визуально" toggle (Удалённые сообщения screen) is on and the
+// message is a non-service message from the other side. Kept as a thin wrapper around the
+// stock menu builder below (renamed …Real, same pattern as Ghost mode's read-state wrapper in
+// SynchronizePeerReadState.swift) so this ~4000-line function stays untouched.
 func contextMenuForChatPresentationInterfaceState(chatPresentationInterfaceState: ChatPresentationInterfaceState, context: AccountContext, messages: [EngineRawMessage], controllerInteraction: ChatControllerInteraction?, selectAll: Bool, interfaceInteraction: ChatPanelInterfaceInteraction?, readStats: MessageReadStats? = nil, messageNode: ChatMessageItemView? = nil) -> Signal<ContextController.Items, NoError> {
+    let baseItems = contextMenuForChatPresentationInterfaceStateReal(chatPresentationInterfaceState: chatPresentationInterfaceState, context: context, messages: messages, controllerInteraction: controllerInteraction, selectAll: selectAll, interfaceInteraction: interfaceInteraction, readStats: readStats, messageNode: messageNode)
+
+    guard messages.count == 1, let message = messages.first, let author = message.author, author.id != context.account.peerId, !message.media.contains(where: { $0 is TelegramMediaAction }) else {
+        return baseItems
+    }
+
+    return combineLatest(baseItems, PampGramCore.settingsSignal(postbox: context.account.postbox))
+    |> map { items, settings -> ContextController.Items in
+        guard settings.visualEditEnabled, case let .list(list) = items.content else {
+            return items
+        }
+        var items = items
+        var newList = list
+        newList.append(.separator)
+        newList.append(.action(ContextMenuActionItem(text: "PampGram", textColor: .primary, icon: { _ in
+            return pampGramSettingsIcon(size: 24.0)
+        }, iconSource: nil, action: { c, _ in
+            var subItems: [ContextMenuItem] = []
+            subItems.append(.action(ContextMenuActionItem(text: chatPresentationInterfaceState.strings.Common_Back, textColor: .primary, icon: { theme in
+                return generateTintedImage(image: UIImage(bundleImageName: "Chat/Context Menu/Back"), color: theme.actionSheet.primaryTextColor)
+            }, iconSource: nil, iconPosition: .left, action: { c, _ in
+                c?.popItems()
+            })))
+            subItems.append(.separator)
+            subItems.append(.action(ContextMenuActionItem(text: "Изменить текст", textColor: .primary, icon: { theme in
+                return generateTintedImage(image: UIImage(systemName: "pencil"), color: theme.actionSheet.primaryTextColor)
+            }, iconSource: nil, action: { _, f in
+                f(.dismissWithoutContent)
+                controllerInteraction?.navigationController()?.pushViewController(pampGramVisualEditController(context: context, messageId: message.id, currentText: message.text))
+            })))
+            subItems.append(.action(ContextMenuActionItem(text: "Отправить фото", textColor: .primary, icon: { theme in
+                return generateTintedImage(image: UIImage(systemName: "photo"), color: theme.actionSheet.primaryTextColor)
+            }, iconSource: nil, action: { _, f in
+                f(.dismissWithoutContent)
+                if #available(iOS 14.0, *) {
+                    pampGramPresentInsertPhoto(context: context, peerId: message.id.peerId)
+                }
+            })))
+            subItems.append(.action(ContextMenuActionItem(text: "Отправить голосовое", textColor: .primary, icon: { theme in
+                return generateTintedImage(image: UIImage(systemName: "waveform"), color: theme.actionSheet.primaryTextColor)
+            }, iconSource: nil, action: { _, f in
+                f(.dismissWithoutContent)
+                if #available(iOS 14.0, *) {
+                    pampGramPresentInsertFile(context: context, peerId: message.id.peerId, asVoice: true)
+                }
+            })))
+            subItems.append(.action(ContextMenuActionItem(text: "Отправить файл", textColor: .primary, icon: { theme in
+                return generateTintedImage(image: UIImage(systemName: "doc"), color: theme.actionSheet.primaryTextColor)
+            }, iconSource: nil, action: { _, f in
+                f(.dismissWithoutContent)
+                if #available(iOS 14.0, *) {
+                    pampGramPresentInsertFile(context: context, peerId: message.id.peerId, asVoice: false)
+                }
+            })))
+            subItems.append(.action(ContextMenuActionItem(text: "Показать звонок", textColor: .primary, icon: { theme in
+                return generateTintedImage(image: UIImage(systemName: "phone.arrow.down.left"), color: theme.actionSheet.primaryTextColor)
+            }, iconSource: nil, action: { _, f in
+                f(.dismissWithoutContent)
+                pampGramPresentInsertCall(context: context, peerId: message.id.peerId)
+            })))
+            c?.pushItems(items: .single(ContextController.Items(content: .list(subItems))))
+        })))
+        items.content = .list(newList)
+        return items
+    }
+}
+
+private func contextMenuForChatPresentationInterfaceStateReal(chatPresentationInterfaceState: ChatPresentationInterfaceState, context: AccountContext, messages: [EngineRawMessage], controllerInteraction: ChatControllerInteraction?, selectAll: Bool, interfaceInteraction: ChatPanelInterfaceInteraction?, readStats: MessageReadStats? = nil, messageNode: ChatMessageItemView? = nil) -> Signal<ContextController.Items, NoError> {
     guard let interfaceInteraction = interfaceInteraction, let controllerInteraction = controllerInteraction else {
         return .single(ContextController.Items(content: .list([])))
     }
