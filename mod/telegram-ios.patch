--- /dev/null
+++ b/submodules/TelegramUI/Sources/PampGram/PampGramVoiceChanger.swift
@@ -0,0 +1,234 @@
+import Foundation
+import AVFoundation
+import OpusBinding
+import TelegramCore
+import PampGramCore
+
+/// "Изменить голос": pitch-shifts a just-recorded voice message before it's attached to the
+/// outgoing message — entirely offline, entirely local. Never touches live call audio (that
+/// would mean patching real-time WebRTC internals, a completely different and much riskier
+/// thing) — this only ever runs once, against a finished recording, well off any real-time
+/// path. On any failure at any step, the caller gets `nil` back and is expected to fall back
+/// to sending the original, unmodified recording — a voice message that sounds like the
+/// user's real voice is always safe; a corrupted one sent by mistake would not be.
+public enum PampGramVoiceChanger {
+    /// PCM convention `TGOggOpusWriter`/`OggOpusReader` actually use: `OggOpusReader` decodes
+    /// to 48kHz mono 16-bit PCM (`op_read`, sampleRate 48000) and `TGOggOpusWriter` re-encodes
+    /// at 48kHz with a 960-sample (20ms) frame. Processing at the true 48kHz — not the 16kHz
+    /// this originally, wrongly assumed — is what keeps the pitch shift clean (feeding 48kHz
+    /// audio through a 16kHz-declared engine is what made it sound raspy) and keeps the
+    /// duration correct. 960 samples * 2 bytes = 1920-byte frames, matching the writer.
+    private static let sampleRate: Double = 48000
+    private static let frameByteCount = 1920
+
+    /// `compressedData` is a complete Ogg/Opus file, exactly the form voice messages are
+    /// held in before upload (see `ChatControllerMediaRecording.swift`). Returns a new,
+    /// re-encoded Ogg/Opus file with the preset's pitch/rate applied, or `nil` if any step
+    /// failed.
+    public static func apply(to compressedData: Data, preset: PampGramVoicePreset) -> Data? {
+        guard let pcm = self.decode(compressedData) else {
+            return nil
+        }
+        guard let shifted = self.pitchShift(pcm: pcm, pitchCents: preset.pitchCents, rate: preset.rate), !shifted.isEmpty else {
+            return nil
+        }
+        return self.encode(pcm: shifted)
+    }
+
+    private static func decode(_ compressedData: Data) -> [Int16]? {
+        let sourceFile = EngineTempBox.shared.tempFile(fileName: "pampgram_voice_in.ogg")
+        defer {
+            EngineTempBox.shared.dispose(sourceFile)
+        }
+        do {
+            try compressedData.write(to: URL(fileURLWithPath: sourceFile.path))
+        } catch {
+            return nil
+        }
+
+        guard let reader = OggOpusReader(path: sourceFile.path) else {
+            return nil
+        }
+
+        var samples: [Int16] = []
+        // op_read counts in SAMPLES (int16 values), not bytes — both its `bufSize` argument and
+        // its return value. The old code passed the buffer's *byte* size as the capacity (which
+        // let op_read overrun it) and divided the returned *sample* count by 2 as if it were a
+        // byte count, which dropped half of every decoded chunk. That halving is what made a
+        // changed voice message play back at ~2x speed with a chipmunk / raspy pitch. Count in
+        // samples on both sides so the full, correct-length PCM is decoded.
+        let byteCapacity = 65536
+        let sampleCapacity = byteCapacity / 2
+        var buffer = [UInt8](repeating: 0, count: byteCapacity)
+        while true {
+            let samplesRead = buffer.withUnsafeMutableBytes { rawBuffer -> Int32 in
+                return reader.read(rawBuffer.baseAddress!, bufSize: Int32(sampleCapacity))
+            }
+            if samplesRead <= 0 {
+                break
+            }
+            let sampleCount = Int(samplesRead)
+            buffer.withUnsafeBytes { rawBuffer in
+                let int16Pointer = rawBuffer.baseAddress!.assumingMemoryBound(to: Int16.self)
+                samples.append(contentsOf: UnsafeBufferPointer(start: int16Pointer, count: sampleCount))
+            }
+        }
+        return samples.isEmpty ? nil : samples
+    }
+
+    private static func encode(pcm: [Int16]) -> Data? {
+        guard let dataItem = TGDataItem(data: Data()) else {
+            return nil
+        }
+        let writer = TGOggOpusWriter()
+        guard writer.begin(with: dataItem) else {
+            return nil
+        }
+
+        let samples = pcm
+        let samplesPerFrame = self.frameByteCount / 2
+        var offset = 0
+        var wroteAnyFrame = false
+        while offset < samples.count {
+            let remaining = samples.count - offset
+            let thisFrameSamples = min(samplesPerFrame, remaining)
+            var frameBytes = [UInt8](repeating: 0, count: thisFrameSamples * 2)
+            samples.withUnsafeBufferPointer { samplesPointer in
+                frameBytes.withUnsafeMutableBytes { framePointer in
+                    let source = UnsafeRawPointer(samplesPointer.baseAddress!.advanced(by: offset))
+                    framePointer.copyMemory(from: UnsafeRawBufferPointer(start: source, count: thisFrameSamples * 2))
+                }
+            }
+            let ok = frameBytes.withUnsafeMutableBytes { framePointer -> Bool in
+                return writer.writeFrame(framePointer.baseAddress?.assumingMemoryBound(to: UInt8.self), frameByteCount: UInt(framePointer.count))
+            }
+            if !ok {
+                return nil
+            }
+            wroteAnyFrame = true
+            offset += thisFrameSamples
+        }
+        // Opus is a streaming format — the encoder needs an explicit "no more data" frame to
+        // flush its final packet, the same call `ManagedAudioRecorder.swift`'s own trim path
+        // uses (`writeFrame(nil, frameByteCount: 0)`).
+        _ = writer.writeFrame(nil, frameByteCount: 0)
+        guard wroteAnyFrame else {
+            return nil
+        }
+
+        return dataItem.data()
+    }
+
+    /// Offline `AVAudioEngine` manual-rendering pitch shift — never touches a real-time audio
+    /// thread, runs synchronously against a static in-memory buffer.
+    private static func pitchShift(pcm: [Int16], pitchCents: Float, rate: Float) -> [Int16]? {
+        guard !pcm.isEmpty, let format = AVAudioFormat(commonFormat: .pcmFormatFloat32, sampleRate: self.sampleRate, channels: 1, interleaved: false) else {
+            return nil
+        }
+        guard let inputBuffer = AVAudioPCMBuffer(pcmFormat: format, frameCapacity: AVAudioFrameCount(pcm.count)) else {
+            return nil
+        }
+        inputBuffer.frameLength = AVAudioFrameCount(pcm.count)
+        guard let inputChannel = inputBuffer.floatChannelData?[0] else {
+            return nil
+        }
+        for i in 0 ..< pcm.count {
+            inputChannel[i] = Float(pcm[i]) / 32768.0
+        }
+
+        let engine = AVAudioEngine()
+        let player = AVAudioPlayerNode()
+        let pitchUnit = AVAudioUnitTimePitch()
+        pitchUnit.pitch = pitchCents
+        pitchUnit.rate = rate
+        // Higher overlap = smoother, less "raspy"/metallic pitch shifting. It costs CPU, but
+        // this runs once, offline, on a finished recording, so the top of the range is free.
+        pitchUnit.overlap = 32.0
+
+        engine.attach(player)
+        engine.attach(pitchUnit)
+        engine.connect(player, to: pitchUnit, format: format)
+        engine.connect(pitchUnit, to: engine.mainMixerNode, format: format)
+
+        do {
+            try engine.enableManualRenderingMode(.offline, format: format, maximumFrameCount: 4096)
+        } catch {
+            return nil
+        }
+        do {
+            try engine.start()
+        } catch {
+            return nil
+        }
+
+        player.scheduleBuffer(inputBuffer, completionHandler: nil)
+        player.play()
+
+        guard let outputBuffer = AVAudioPCMBuffer(pcmFormat: format, frameCapacity: engine.manualRenderingMaximumFrameCount) else {
+            engine.stop()
+            return nil
+        }
+
+        var outputSamples: [Int16] = []
+        // The time-pitch unit changes duration by 1/rate, so the real output is about
+        // pcm.count / rate samples. In offline manual-rendering mode a player node keeps
+        // returning `.success` with full buffers of pure silence once its scheduled audio is
+        // consumed — the engine has no idea the player is "done" — so rendering to any generous
+        // upper bound appends seconds of trailing silence (the "empty tail" heard at the end of a
+        // changed voice message). Render only the expected length plus a small cushion for the
+        // unit's own latency/flush tail, then trim whatever trailing silence remains below.
+        let expectedOutputFrames = Int((Double(pcm.count) / Double(max(0.01, rate))).rounded())
+        let latencyCushionFrames = Int(self.sampleRate * 0.12)
+        let renderFrameCap = expectedOutputFrames + latencyCushionFrames
+        var renderedFrames = 0
+        renderLoop: while renderedFrames < renderFrameCap {
+            outputBuffer.frameLength = 0
+            let status: AVAudioEngineManualRenderingStatus
+            do {
+                status = try engine.renderOffline(engine.manualRenderingMaximumFrameCount, to: outputBuffer)
+            } catch {
+                break renderLoop
+            }
+            switch status {
+            case .success:
+                let length = Int(outputBuffer.frameLength)
+                if length == 0 {
+                    break renderLoop
+                }
+                if let outputChannel = outputBuffer.floatChannelData?[0] {
+                    for i in 0 ..< length {
+                        let sample = max(-1.0, min(1.0, outputChannel[i]))
+                        outputSamples.append(Int16(sample * 32767.0))
+                    }
+                }
+                renderedFrames += length
+            case .insufficientDataFromInputNode:
+                break renderLoop
+            case .cannotDoInCurrentContext:
+                continue renderLoop
+            case .error:
+                engine.stop()
+                return nil
+            @unknown default:
+                engine.stop()
+                return nil
+            }
+        }
+
+        engine.stop()
+
+        // Trim trailing near-silence: the unit's flush tail (and the cushion above) render as
+        // effectively silent samples, and the recorder would otherwise pad the voice message with
+        // an empty stretch after the speech. A low threshold only ever catches true silence, never
+        // speech, so the changed message is exactly as long as what was said.
+        let silenceThreshold: Int32 = 24
+        var trimmedEnd = outputSamples.count
+        while trimmedEnd > 0 && abs(Int32(outputSamples[trimmedEnd - 1])) < silenceThreshold {
+            trimmedEnd -= 1
+        }
+        if trimmedEnd < outputSamples.count {
+            outputSamples.removeLast(outputSamples.count - trimmedEnd)
+        }
+        return outputSamples
+    }
+}
