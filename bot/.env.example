# Токен бота от @BotFather (в настройках бота включите Business Mode)
BOT_TOKEN=123456:ABC-DEF
# Telegram ID владельцев через запятую — только эти аккаунты могут подключить бота и управлять им
OWNER_IDS=123456789
# Куда сохранять привязки (по умолчанию ./data)
DATA_DIR=data
# 1 — пересылать входящие личные сообщения аккаунта в бот с кнопкой «Ответить»
FORWARD_MESSAGES=0
